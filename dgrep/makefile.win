######################################################################
#
#	Makefile for dgrep and test programs in Windows with Visual C++.
#	Run from a Developer Command Prompt:
#
#	nmake -f makefile.win		builds dgrep.exe and try.exe
#	nmake -f makefile.win test	builds also dgrep-smallbuf.exe and
#					runs regress.sh (needs Git Bash)
#	nmake -f makefile.win bench	runs bench.sh (needs Git Bash)
#
######################################################################

CC	= cl
# -GL and -LTCG: whole program (link time) optimization, 6-10% faster
CFLAGS	= -nologo -O2 -GL -W3 -std:c11
LFLAGS	= -link -LTCG

DFASRC	= dfaregex.c dfa.c calcpos.c dfatree.c regmust.c set.c clib.c getopt.c
DGREPSRC = dgrep.c bm.c walk.c $(DFASRC)
HEADERS	= system.h dfa.h set.h dfaregex.h bm.h getopt.h walk.h

DFAOBJ	= dfaregex.obj dfa.obj calcpos.obj dfatree.obj regmust.obj set.obj \
	  clib.obj getopt.obj
DGREPOBJ = dgrep.obj bm.obj walk.obj $(DFAOBJ)
TRYOBJ	= try.obj $(DFAOBJ)

# setargv.obj comes with Visual C++ and expands wildcards in file names
WILDARG	= setargv.obj

all: dgrep.exe try.exe

dgrep.exe: $(DGREPOBJ)
	$(CC) $(CFLAGS) -Fedgrep.exe $(DGREPOBJ) $(WILDARG) $(LFLAGS)

try.exe: $(TRYOBJ)
	$(CC) $(CFLAGS) -Fetry.exe $(TRYOBJ) $(LFLAGS)

# dgrep with a tiny input buffer for testing buffer boundaries
dgrep-smallbuf.exe: $(DGREPSRC) $(HEADERS)
	if not exist smallbuf mkdir smallbuf
	$(CC) $(CFLAGS) -DINITBUF=256 -Fosmallbuf\ -Fedgrep-smallbuf.exe $(DGREPSRC) $(WILDARG) $(LFLAGS)

$(DGREPOBJ) try.obj: $(HEADERS)

.c.obj:
	$(CC) $(CFLAGS) -c $<

test: dgrep.exe try.exe dgrep-smallbuf.exe
	bash regress.sh dgrep.exe try.exe dgrep-smallbuf.exe

bench: dgrep.exe
	bash bench.sh dgrep.exe

clean:
	-del *.obj dgrep.exe try.exe dgrep-smallbuf.exe 2>nul
	-if exist smallbuf rmdir /s /q smallbuf
